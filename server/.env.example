# HTTP port of this backend (also serves the built client from ../client/dist)
PORT=

# Only these CIDR ranges may access the app (comma-separated, IPv4/IPv6).
# Any other source IP receives 403. Adjust to your network as needed.
ALLOWED_CIDRS=
# Set true ONLY when running nginx in front of this app, so the real client
# IP is read from X-Forwarded-For instead of the proxy address.
# TRUST_PROXY=false

# SQL Server connection of your own database
DB_SERVER=
DB_PORT=
DB_DATABASE=
DB_USER=sa
DB_PASSWORD
# On-premise SQL Server usually: encrypt=false, trustServerCertificate=true
DB_ENCRYPT=false
DB_TRUST_SERVER_CERT=true
DB_TIMEOUT=

# Optional override of the built client folder
# CLIENT_DIST=../client/dist
